. *===============================================================================
. * 12. LOCK WP-12A FINAL LONG SAMPLE
. *===============================================================================
. 
. if `ncommon' != 3303 {
.     di as error "Expected 3,303 observations in WP-12A common sample."
.     exit 459
. }

. 
. if `ncommon_bonds' != 93 {
.     di as error "Expected 93 bonds in WP-12A common sample."
.     exit 459
. }

. 
. if `ncommon_issuers' != 44 {
.     di as error "Expected 44 issuers in WP-12A common sample."
.     exit 459
. }

. 
. if `common_first' != tm(2011m3) {
.     di as error "Expected WP-12A common sample to start in 2011m3."
.     exit 459
. }

. 
. if `common_last' != tm(2025m6) {
.     di as error "Expected WP-12A common sample to end in 2025m6."
.     exit 459
. }

. 
. di as result "WP-12A final long-sample lock: PASS"
WP-12A final long-sample lock: PASS

. 
. *===============================================================================
. * 13. PANEL SETUP FOR DRISCOLL-KRAAY
. *===============================================================================
. 
. encode bond_id, gen(bond_id_num)

. egen t_dk = group(month_id)

. xtset bond_id_num t_dk
       panel variable:  bond_id_num (unbalanced)
        time variable:  t_dk, 1 to 175
                delta:  1 unit

. 
. capture which xtscc

. if _rc {
.     di as error "xtscc is not installed."
.     exit 499
. }

. 
. capture which esttab

. if _rc {
.     di as error "esttab/estout is not installed."
.     exit 499
. }

. 
. *===============================================================================
. * 14. ESTIMATE FINAL EIGHT MODELS
. *===============================================================================
. 
. forvalues m = 1/8 {
  2. 
.     di as text "============================================================"
  3.     di as text "FINAL FE-DK MODEL `m'"
  4.     di as text "============================================================"
  5. 
.     xtscc spread `model`m'_x' if sample_common, fe lag(4)
  6.     estimates store M`m'_DK
  7. 
.     local m`m'_N   = e(N)
  8.     local m`m'_Ng  = e(N_g)
  9.     local m`m'_r2w = e(r2_w)
 10. 
.     if `m`m'_N' != `ncommon' {
 11.         di as error "Model `m' does not use the locked WP-12A common sample."
 12.         exit 459
 13.     }
 14. 
.     if `m`m'_Ng' != `ncommon_bonds' {
 15.         di as error "Model `m' does not use all locked WP-12A common-sample bonds."
 16.         exit 459
 17.     }
 18. 
.     * Companion FE regression only to recover rho.
.     xtreg spread `model`m'_x' if sample_common, fe
 19.     local m`m'_rho = e(rho)
 20. 
.     estadd scalar rho = `m`m'_rho' : M`m'_DK
 21. }
