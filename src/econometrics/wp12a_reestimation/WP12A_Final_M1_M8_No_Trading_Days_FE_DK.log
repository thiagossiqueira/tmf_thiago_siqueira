. 
. count if sample_common
  3,303

. local ncommon = r(N)

. 
. quietly summarize month_id if sample_common, meanonly

. local common_first = r(min)

. local common_last  = r(max)

. 
. levelsof bond_id if sample_common, local(common_bonds)
