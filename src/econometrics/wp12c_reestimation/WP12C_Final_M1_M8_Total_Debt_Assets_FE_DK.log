. *============================================================================
> ===
. * 9. NATURAL COMPLETE-CASE SAMPLE BY MODEL
. *============================================================================
> ===
. 
. forvalues m = 1/8 {
  2.     gen byte sample_m`m' = 1
  3.     markout sample_m`m' spread `model`m'_x'
  4. 
.     di as text "============================================================"
  5.     di as text "MODEL `m' NATURAL COMPLETE-CASE SAMPLE"
  6. 
.     count if sample_m`m'
  7.     local nobs = r(N)
  8.     di as result "Observations: `nobs'"
  9. 
.     quietly summarize month_id if sample_m`m', meanonly
 10.     di as result "First month: " %tm r(min)
 11.     di as result "Last month:  " %tm r(max)
 12. 
.     levelsof bond_id if sample_m`m', local(bonds)
 13.     local nbonds : word count `bonds'
 14.     di as result "Number of bonds: `nbonds'"
 15. 
.     levelsof issuer if sample_m`m', local(issuers)
 16.     local nissuers : word count `issuers'
 17.     di as result "Number of issuers: `nissuers'"
 18. 
.     if `nobs' != 4648 {
 19.         di as error "Model `m' should retain the full 4,648-observation pa
> nel."
 20.         exit 459
 21.     }
 22. }
