. count
  4,648

. local bridge_panel = r(N)

. if `bridge_panel' != 4648 {
.     di as error "Frozen panel no longer contains 4,648 observations."
.     exit 459
. }

. 
. count if !missing(total_debt_to_total_assets)
  4,648

. local bridge_leverage = r(N)

. if `bridge_leverage' != 4648 {
.     di as error "Total Debt / Total Assets should contain 4,648 observations.
> "
.     exit 459
. }

. 
. count if sample_m8
  4,648

. local bridge_full = r(N)

. if `bridge_full' != 4648 {
.     di as error "M8 natural complete-case sample should contain 4,648 observa
> tions."
.     exit 459
. }

