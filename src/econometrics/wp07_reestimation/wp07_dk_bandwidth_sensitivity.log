. *============================================================================
> ===
. * 13. ESTIMATE FINAL SEVEN MODELS: DK LAG(4) VS DK LAG(2)
. *
. * WP-07 rule:
. *   Same dependent variable, regressors, sample and bond fixed effects.
. *   The only econometric change is DK maximum lag: 4 -> 2.
. *
. * Baseline estimates retain canonical names M1_DK ... M7_DK.
. * Sensitivity estimates are stored as M1_DK2 ... M7_DK2.
. *============================================================================
> ===
. 
. forvalues m = 1/7 {
  2. 
.     di as text "============================================================"
  3.     di as text "WP-07 FE-DK MODEL `m': BASELINE LAG(4)"
  4.     di as text "==========================================================
> =="
  5. 
.     * Baseline: frozen DK lag(4).
.     xtscc spread `model`m'_x' if sample_common, fe lag(4)
  6.     estimates store M`m'_DK
  7. 
.     local m`m'_N   = e(N)
  8.     local m`m'_Ng  = e(N_g)
  9.     local m`m'_r2w = e(r2_w)
 10. 
.     if `m`m'_N' != 4648 {
 11.         di as error "Lag(4) Model `m' does not use 4,648 observations."
 12.         exit 459
 13.     }
 14. 
.     if `m`m'_Ng' != 103 {
 15.         di as error "Lag(4) Model `m' does not use 103 bonds."
 16.         exit 459
 17.     }
 18. 
.     gen byte __wp07_es4_m`m' = e(sample)
 19. 
.     count if __wp07_es4_m`m' != sample_common
 20.     if r(N) != 0 {
 21.         di as error "Lag(4) e(sample) differs from locked sample_common in
>  Model `m'."
 22.         exit 459
 23.     }
 24. 
.     di as text "------------------------------------------------------------"
 25.     di as text "WP-07 FE-DK MODEL `m': SENSITIVITY LAG(2)"
 26.     di as text "----------------------------------------------------------
> --"
 27. 
.     * Sensitivity: ONLY the DK bandwidth changes from 4 to 2.
.     xtscc spread `model`m'_x' if sample_common, fe lag(2)
 28.     estimates store M`m'_DK2
 29. 
.     local m`m'_N2   = e(N)
 30.     local m`m'_Ng2  = e(N_g)
 31.     local m`m'_r2w2 = e(r2_w)
 32. 
.     if `m`m'_N2' != 4648 {
 33.         di as error "Lag(2) Model `m' does not use 4,648 observations."
 34.         exit 459
 35.     }
 36. 
.     if `m`m'_Ng2' != 103 {
 37.         di as error "Lag(2) Model `m' does not use 103 bonds."
 38.         exit 459
 39.     }
 40. 
.     gen byte __wp07_es2_m`m' = e(sample)
 41. 
.     count if __wp07_es2_m`m' != sample_common
 42.     if r(N) != 0 {
 43.         di as error "Lag(2) e(sample) differs from locked sample_common in
>  Model `m'."
 44.         exit 459
 45.     }
 46. 
.     count if __wp07_es4_m`m' != __wp07_es2_m`m'
 47.     local sample_diff_m`m' = r(N)
 48. 
.     di as result ///
>         "MODEL `m' COMMON-SAMPLE CHECK: lag(4) vs lag(2) differing observatio
> ns = " ///
>         `sample_diff_m`m''
 49. 
.     if `sample_diff_m`m'' != 0 {
 50.         di as error "Lag(4) and lag(2) estimation samples differ in Model 
> `m'."
 51.         exit 459
 52.     }
 53. 
.     if `m`m'_N' != `m`m'_N2' {
 54.         di as error "Lag(4) and lag(2) N differ in Model `m'."
 55.         exit 459
 56.     }
 57. 
.     if `m`m'_Ng' != `m`m'_Ng2' {
 58.         di as error "Lag(4) and lag(2) bond counts differ in Model `m'."
 59.         exit 459
 60.     }
 61. 
.     * Companion FE regression only to recover rho.
.     * rho does not depend on the DK bandwidth.
.     xtreg spread `model`m'_x' if sample_common, fe
 62.     local m`m'_rho = e(rho)
 63. 
.     estadd scalar rho = `m`m'_rho' : M`m'_DK
 64.     estadd scalar rho = `m`m'_rho' : M`m'_DK2
 65. }
