. *============================================================================
> ===
. * 8. FINAL SEVEN-COLUMN FE-DK X-MATRIX
. *
. * M1  Global factors
. * M2  Global + local macro
. * M3  Global + local macro + sovereign risk
. * M4  Global + sovereign risk
. * M5  Full: global + local + sovereign + firm/bond
. * M6  Global + local monetary 3M rate
. * M7  Brazil 3M robustness with Real Fed 3M omitted
. *
. * Source-accurate implementation:
. *   Real Fed      -> real_fed_3m_spf
. *   USD/BRL RER   -> real_exchange_rate
. *   Brazil 3M     -> real_brazil_3m_focus
. *
. * No nominal USD/BRL.
. * No nominal Fed 3M.
. * No amount_issued_to_bs_tot_asset.
. *============================================================================
> ===
. 
. local model1_x ///
>     vix ///
>     real_fed_3m_spf

. 
. local model2_x ///
>     vix ///
>     real_fed_3m_spf ///
>     real_exchange_rate ///
>     real_brazil_3m_focus ///
>     gdp_yoy ///
>     debt_gdp

. 
. local model3_x ///
>     vix ///
>     real_fed_3m_spf ///
>     real_exchange_rate ///
>     real_brazil_3m_focus ///
>     gdp_yoy ///
>     debt_gdp ///
>     sovereign_spread_brl

. 
. * M4: Full model.
. local model4_x ///
>     vix ///
>     real_fed_3m_spf ///
>     real_exchange_rate ///
>     real_brazil_3m_focus ///
>     gdp_yoy ///
>     debt_gdp ///
>     sovereign_spread_brl ///
>     cf_cash_oper_to_tot_asset ///
>     tot_debt_to_ebitda ///
>     days_to_maturity

. 
. * M5: Full 2 - full model without sovereign risk.
. local model5_x ///
>     vix ///
>     real_fed_3m_spf ///
>     real_exchange_rate ///
>     real_brazil_3m_focus ///
>     gdp_yoy ///
>     debt_gdp ///
>     cf_cash_oper_to_tot_asset ///
>     tot_debt_to_ebitda ///
>     days_to_maturity

. 
. * M6: Full 3 - no sovereign risk and no Real Brazil 3M rate.
. local model6_x ///
>     vix ///
>     real_fed_3m_spf ///
>     real_exchange_rate ///
>     gdp_yoy ///
>     debt_gdp ///
>     cf_cash_oper_to_tot_asset ///
>     tot_debt_to_ebitda ///
>     days_to_maturity

. 
. * M7: Parsimonious global + sovereign-risk model.
. local model7_x ///
>     vix ///
>     real_fed_3m_spf ///
>     sovereign_spread_brl

. 
. *============================================================================
> ===
. * 9. NATURAL COMPLETE-CASE SAMPLE BY MODEL
. *============================================================================
> ===
. 
. forvalues m = 1/7 {
  2.     gen byte sample_m`m' = 1
  3.     markout sample_m`m' spread `model`m'_x'
  4. 
.     di as text "============================================================"
  5.     di as text "MODEL `m' NATURAL COMPLETE-CASE SAMPLE"
  6. 
.     count if sample_m`m'
  7.     local nobs = r(N)
  8.     di as result "Observations: `nobs'"
  9. 
.     quietly summarize month_id if sample_m`m', meanonly
 10.     di as result "First month: " %tm r(min)
 11.     di as result "Last month:  " %tm r(max)
 12. 
.     levelsof bond_id if sample_m`m', local(bonds)
 13.     local nbonds : word count `bonds'
 14.     di as result "Number of bonds: `nbonds'"
 15. 
.     levelsof issuer if sample_m`m', local(issuers)
 16.     local nissuers : word count `issuers'
 17.     di as result "Number of issuers: `nissuers'"
 18. }
