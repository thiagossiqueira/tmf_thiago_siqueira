. *============================================================================
> ===
. * 14. WP-07 DK BANDWIDTH SENSITIVITY AUDIT
. *============================================================================
> ===
. *
. * For identical data, regressors, FE and estimation sample, changing the
. * Driscoll-Kraay maximum lag should affect the variance estimator only.
. * Coefficients should therefore be identical; SE, t, p and stars may change.
. *============================================================================
> ===
. 
. tempname wp07_post

. tempfile wp07_audit_dta

. 
. postfile `wp07_post' ///
>     int model str40 variable ///
>     double b_lag4 se_lag4 t_lag4 p_lag4 ///
>            b_lag2 se_lag2 t_lag2 p_lag2 ///
>            coef_diff se_pct_change ///
>     byte sig_lag4 sig_lag2 ///
>     using "`wp07_audit_dta'", replace
(note: file C:\Users\TSIQUE~1\AppData\Local\Temp\ST_5a1c_000005.tmp not found)

. 
. forvalues m = 1/7 {
  2. 
.     estimates restore M`m'_DK
  3.     local xlist : colnames e(b)
  4. 
.     foreach v of local xlist {
  5. 
.         if "`v'" != "_cons" {
  6. 
.             *---------------------------------------------------------------
.             * Frozen baseline: DK lag(4)
.             *---------------------------------------------------------------
.             estimates restore M`m'_DK
  7. 
.             scalar __b4  = _b[`v']
  8.             scalar __se4 = _se[`v']
  9.             scalar __t4  = __b4 / __se4
 10. 
.             quietly test `v'
 11.             scalar __p4 = r(p)
 12. 
.             *---------------------------------------------------------------
.             * Sensitivity: DK lag(2)
.             *---------------------------------------------------------------
.             estimates restore M`m'_DK2
 13. 
.             scalar __b2  = _b[`v']
 14.             scalar __se2 = _se[`v']
 15.             scalar __t2  = __b2 / __se2
 16. 
.             quietly test `v'
 17.             scalar __p2 = r(p)
 18. 
.             *---------------------------------------------------------------
.             * Direct comparison
.             *---------------------------------------------------------------
.             scalar __bdiff = __b2 - __b4
 19.             scalar __sepct = 100 * (__se2 / __se4 - 1)
 20. 
.             scalar __sig4 = cond(__p4 < .01, 3, ///
>                             cond(__p4 < .05, 2, ///
>                             cond(__p4 < .10, 1, 0)))
 21. 
.             scalar __sig2 = cond(__p2 < .01, 3, ///
>                             cond(__p2 < .05, 2, ///
>                             cond(__p2 < .10, 1, 0)))
 22. 
.             post `wp07_post' ///
>                 (`m') ("`v'") ///
>                 (__b4) (__se4) (__t4) (__p4) ///
>                 (__b2) (__se2) (__t2) (__p2) ///
>                 (__bdiff) (__sepct) ///
>                 (__sig4) (__sig2)
 23. 
.             di as result ///
>                 "WP07_AUDIT|M`m'|`v'" ///
>                 "|b4=" %10.6f __b4 ///
>                 "|se4=" %10.6f __se4 ///
>                 "|t4=" %9.4f __t4 ///
>                 "|p4=" %9.6f __p4 ///
>                 "|b2=" %10.6f __b2 ///
>                 "|se2=" %10.6f __se2 ///
>                 "|t2=" %9.4f __t2 ///
>                 "|p2=" %9.6f __p2 ///
>                 "|SEpct=" %9.3f __sepct ///
>                 "|sig4=" %1.0f __sig4 ///
>                 "|sig2=" %1.0f __sig2
 24. 
.             * Coefficients must not change when only DK bandwidth changes.
.             if abs(__bdiff) > 1e-10 {
 25.                 di as error ///
>                     "ERROR: coefficient changed between lag(4) and lag(2): M`
> m' `v'"
 26.                 exit 459
 27.             }
 28.         }
 29.     }
 30. }
